{
  "name": "writely",
  "version": "0.2.0-alpha.1",
  "description": "Writely – ein ruhiger Ort für gute Gedanken. Lokale Schreibapp für Windows.",
  "author": "Writely contributors",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test tests/*.test.*",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop": "node scripts/desktop-smoke.cjs"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "font-list": "^2.0.1",
    "htmlparser2": "^10.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "marked": "^17.0.0",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.8",
    "@playwright/test": "^1.56.1",
    "@tiptap/extension-highlight": "^3.10.0",
    "@tiptap/extension-image": "^3.10.0",
    "@tiptap/extension-table": "^3.10.0",
    "@tiptap/extension-text-align": "^3.10.0",
    "@tiptap/extension-text-style": "^3.10.0",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "de.writely.desktop",
    "productName": "Writely",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "artifactName": "Writely-${version}-Windows-x64.${ext}",
      "icon": "public/writely.ico",
      "signExecutable": false
    },
    "linux": {
      "target": "dir",
      "category": "Office"
    },
    "extraFiles": [
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": ".tools",
        "to": "tools",
        "filter": [
          "pandoc.exe",
          "pandoc-source.tar.gz",
          "COPYING.md",
          "COPYRIGHT"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/writely.ico",
      "uninstallerIcon": "public/writely.ico",
      "artifactName": "Writely-${version}-Setup-x64.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "writely",
        "name": "Writely-Dokument",
        "role": "Editor",
        "icon": "public/writely.ico"
      }
    ]
  }
}
